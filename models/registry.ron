// The model catalog crown-context-inferd picks from: per task, the candidates in preference
// order, with the execution providers each one runs on. Entries are placeholders until the
// hardware bake-off (docs/08 phase 0) fills in measured latency and accuracy.
(
    version: 1,
    tasks: {
        "ocr_detect": [
            (name: "pp-ocrv4-det", format: "onnx", sha256: "", licence: "Apache-2.0",
             input: (shape: [1, 3, 640, 640], dtype: "f32"),
             providers: ["openvino", "vitisai", "cuda", "cpu"]),
        ],
        "ocr_recognize": [
            (name: "pp-ocrv4-rec-en", format: "onnx", sha256: "", licence: "Apache-2.0",
             input: (shape: [1, 3, 48, 320], dtype: "f32"),
             providers: ["openvino", "vitisai", "cuda", "cpu"]),
        ],
        "embed_text": [
            (name: "bge-small-en-v1.5-int8", format: "onnx", sha256: "", licence: "MIT",
             input: (shape: [1, 512], dtype: "i64"),
             providers: ["openvino", "cuda", "cpu"]),
        ],
        "generate": [
            (name: "qwen2.5-1.5b-instruct-q4_k_m", format: "gguf", sha256: "", licence: "Apache-2.0",
             input: (shape: [], dtype: "tokens"),
             providers: ["cuda", "vulkan", "cpu"]),
        ],
    },
)
