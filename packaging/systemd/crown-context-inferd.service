# No file system or network namespace options (ProtectSystem=, ProtectHome=, ReadWritePaths=,
# PrivateTmp=, PrivateNetwork= and the like). In a user unit each of them puts the process in a
# new user namespace. Reading /proc/<pid>/exe of a peer (crown-contextd) is a ptrace-read check, and the kernel
# refuses it across user namespaces, so every peer would be unidentified. The user also owns
# that namespace, so any other process of the user could attach to this one in spite of
# PR_SET_DUMPABLE=0. The hardening is seccomp, address families and resource limits.
[Unit]
Description=CrownOS context inference worker
Requires=crown-context-inferd.socket
After=crown-context-inferd.socket

[Service]
Type=simple
ExecStart=/usr/bin/crown-context-inferd
Restart=on-failure
RestartSec=3
# GPU drivers compile shaders and kernels once and keep them in the service cache.
Environment=MESA_SHADER_CACHE_DIR=%C/crownos/context/mesa
Environment=__GL_SHADER_DISK_CACHE_PATH=%C/crownos/context/nvidia
Environment=CUDA_CACHE_PATH=%C/crownos/context/cuda
# Models, prompts and pixels stay in this process: no network, no swap, no core dumps.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
MemorySwapMax=0
MemoryZSwapMax=0
MemoryHigh=6G
MemoryMax=8G
LimitCORE=0
NoNewPrivileges=yes
CacheDirectory=crownos/context
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# A user manager may not apply DeviceAllow= (it needs a cgroup device controller the user
# can delegate); the lines document the devices the service needs.
DeviceAllow=char-drm rw
DeviceAllow=char-accel rw
DeviceAllow=char-kfd rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-uvm rw
CPUWeight=20
IOWeight=20
Nice=10
