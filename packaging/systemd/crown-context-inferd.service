# inferd parses screen pixels in ONNX Runtime and llama.cpp, so it keeps the file system
# sandbox: it reads the models, writes its cache and nothing else. It cannot open
# crown-contextd's state directory, so not its database or its key, nor the runtime directory
# with the user bus and the Wayland socket. inferd serves any process
# of the user (a 0600 socket in the runtime directory) and does not identify its peer, so the
# user namespace these options make costs nothing here.
[Unit]
Description=CrownOS context inference worker
Requires=crown-context-inferd.socket
After=crown-context-inferd.socket

[Service]
Type=simple
ExecStart=/usr/bin/crown-context-inferd
Restart=on-failure
RestartSec=3
# GPU drivers compile shaders and kernels once and keep them in the service cache.
Environment=MESA_SHADER_CACHE_DIR=%C/crownos/context/mesa
Environment=__GL_SHADER_DISK_CACHE_PATH=%C/crownos/context/nvidia
Environment=CUDA_CACHE_PATH=%C/crownos/context/cuda
# Models, prompts and pixels stay in this process: no network, no swap, no core dumps.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemorySwapMax=0
MemoryZSwapMax=0
MemoryHigh=6G
MemoryMax=8G
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# crown-contextd's state directory (its database and key) and the whole runtime directory: the
# user bus, the systemd socket, the Wayland and audio sockets. The inferd socket comes from the
# socket unit as a file descriptor. ExecStartPre makes the state directory first, unsandboxed,
# so the rule always applies.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %S/crownos/context
InaccessiblePaths=%S/crownos/context %t
CacheDirectory=crownos/context
ReadWritePaths=%C/crownos/context
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# A user manager may not apply DeviceAllow= (it needs a cgroup device controller the user
# can delegate); the lines document the devices the service needs.
DeviceAllow=char-drm rw
DeviceAllow=char-accel rw
DeviceAllow=char-kfd rw
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-uvm rw
CPUWeight=20
IOWeight=20
Nice=10
