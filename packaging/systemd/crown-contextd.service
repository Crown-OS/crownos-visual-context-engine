# No file system or network namespace options (ProtectSystem=, ProtectHome=, ReadWritePaths=,
# PrivateTmp=, PrivateNetwork= and the like). In a user unit each of them puts the process in a
# new user namespace. Reading /proc/<pid>/exe of a peer (an API caller) is a ptrace-read check, and the kernel
# refuses it across user namespaces, so every peer would be unidentified. The user also owns
# that namespace, so any other process of the user could attach to this one in spite of
# PR_SET_DUMPABLE=0. The hardening is seccomp, address families and resource limits.
[Unit]
Description=CrownOS visual context engine
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=!/run/archiso
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'test -n "$WAYLAND_DISPLAY"'
ExecStart=/usr/bin/crown-contextd
# The compositor refuses the engine to a process that loads other code.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH
Restart=on-failure
RestartSec=3
RuntimeDirectory=crownos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
StateDirectory=crownos/context
CacheDirectory=crownos/context
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
CPUWeight=20
IOWeight=20
MemoryHigh=256M
Nice=10
LimitCORE=0
# Frames are not swapped: contextd faults each frame in at allocation, so its pages count
# against this cgroup, where swap is off. LimitMEMLOCK is not set: a user unit cannot raise it
# above the user manager's limit (8 MiB), so mlock stays best effort.
MemorySwapMax=0
MemoryZSwapMax=0

[Install]
WantedBy=default.target
