[Unit]
Description=CrownOS visual context engine
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=!/run/archiso
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'test -n "$WAYLAND_DISPLAY"'
ExecStart=/usr/bin/crown-contextd
Restart=on-failure
RestartSec=3
RuntimeDirectory=crownos
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/crownos/context %C/crownos/context
StateDirectory=crownos/context
CacheDirectory=crownos/context
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
CPUWeight=20
IOWeight=20
MemoryHigh=256M
Nice=10

[Install]
WantedBy=default.target
